# Reads a Filelist.txt (make syntax) and returns its sources as full paths.
#
# Understands the subset the Filelists use: SRCF90/SRCF77/SRCCXX with = or +=,
# backslash continuation, # comments and ifdef/ifndef/endif on a flag name.
# A flag counts as defined when the CMake variable ROCFLU_DEF_<flag> is true.
#
#   rocflu_read_filelist(<dir> <out_var>)

function(rocflu_read_filelist dir out_var)
  file(STRINGS "${dir}/Filelist.txt" lines)

  set(sources "")
  set(active_stack "")   # one entry per open ifdef: 1 = taken, 0 = skipped
  set(active TRUE)
  set(continuing FALSE)

  foreach(line IN LISTS lines)
    string(REGEX REPLACE "#.*$" "" line "${line}")
    string(STRIP "${line}" line)

    if(NOT continuing)
      if(line MATCHES "^(ifdef|ifndef)[ \t]+([A-Za-z0-9_]+)")
        set(flag "${CMAKE_MATCH_2}")
        if(ROCFLU_DEF_${flag})
          set(taken TRUE)
        else()
          set(taken FALSE)
        endif()
        if(CMAKE_MATCH_1 STREQUAL "ifndef")
          if(taken)
            set(taken FALSE)
          else()
            set(taken TRUE)
          endif()
        endif()
        list(APPEND active_stack "${taken}")
        set(active TRUE)
        foreach(level IN LISTS active_stack)
          if(NOT level)
            set(active FALSE)
          endif()
        endforeach()
        continue()
      elseif(line MATCHES "^endif")
        list(POP_BACK active_stack)
        set(active TRUE)
        foreach(level IN LISTS active_stack)
          if(NOT level)
            set(active FALSE)
          endif()
        endforeach()
        continue()
      elseif(line MATCHES "^else")
        message(FATAL_ERROR "${dir}/Filelist.txt: 'else' is not supported")
      elseif(line MATCHES "^SRC(F90|F77|CXX)[ \t]*\\+?=(.*)$")
        set(line "${CMAKE_MATCH_2}")
      elseif(line STREQUAL "")
        continue()
      else()
        message(FATAL_ERROR "${dir}/Filelist.txt: cannot parse '${line}'")
      endif()
    endif()

    set(continuing FALSE)
    if(line MATCHES "\\\\$")
      set(continuing TRUE)
      string(REGEX REPLACE "\\\\$" "" line "${line}")
    endif()

    if(active)
      string(REGEX REPLACE "[ \t]+" ";" names "${line}")
      foreach(name IN LISTS names)
        if(NOT name STREQUAL "")
          if(NOT EXISTS "${dir}/${name}")
            message(FATAL_ERROR "${dir}/Filelist.txt lists missing file ${name}")
          endif()
          list(APPEND sources "${dir}/${name}")
        endif()
      endforeach()
    endif()
  endforeach()

  set(${out_var} "${sources}" PARENT_SCOPE)
endfunction()
