# ppiclF slot layout, from libpicl/user_files/ppiclf_slots.txt (see its
# header for the format).
#
#   ppiclf_layout(<table> <case> <layout_header> <check_include> <out_groups>)
#
# <case>: a case input file (.inp), or empty for a build with every group.
# Writes <layout_header> (PPICLF_LAYOUT.h: the slot numbers) and
# <check_include> (Fortran, included by PICL_InitSolver: stops a run whose
# input needs a group this build does not have), and returns the groups
# built in <out_groups>.

# Input keys a rule may use, and the Fortran value Rocflu reads them into
# (in PICL_InitSolver). A missing key counts as 0, Rocflu's default.
set(PPICLF_RULE_KEYS
  COLLISIONS      global%piclCollisionFlag
  HEATTRANSFER    global%piclHeatTransferFlag
  QSFLUCT         global%piclQSFluctFlag
  PSEUDOTURB      global%piclPseudoTurbFlag
  MODEL_WRT        global%piclOutModel
  AMFORCE         global%piclAmFlag
  PGFORCE         global%piclPgFlag
  VISCOUSUNSTEADY global%piclViscousUnsteady
  FLOWMODEL/MODEL pRegion%mixtInput%flowModel)

# Section and key of a rule key (PICL section unless SECTION/KEY).
function(_ppiclf_split_key key out_section out_key)
  if(key MATCHES "^([A-Z]+)/(.+)$")
    set(${out_section} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(${out_key} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${out_section} "PICL" PARENT_SCOPE)
    set(${out_key} "${key}" PARENT_SCOPE)
  endif()
endfunction()

# Value of KEY in SECTION of a Rocflu input file: a section starts with
# '# SECTION' and ends with a line '#'; a key line is 'KEY value ! comment'
# (a key may have several words, e.g. 'DU HEATTRANSFER').
function(_ppiclf_input_value case section key out_value)
  file(STRINGS "${case}" lines)
  set(inside FALSE)
  set(value 0)
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "!.*$" "" line "${line}")
    string(STRIP "${line}" line)
    if(line MATCHES "^#[ \t]*([A-Za-z_]+)")
      string(TOUPPER "${CMAKE_MATCH_1}" name)
      if(name STREQUAL section)
        set(inside TRUE)
      else()
        set(inside FALSE)
      endif()
    elseif(line MATCHES "^#")
      set(inside FALSE)
    elseif(inside AND NOT line STREQUAL "")
      string(REGEX REPLACE "[ \t]+" ";" words "${line}")
      list(POP_BACK words last)
      list(JOIN words " " line_key)
      string(TOUPPER "${line_key}" line_key)
      if(line_key STREQUAL key)
        set(value "${last}")
      endif()
    endif()
  endforeach()
  set(${out_value} "${value}" PARENT_SCOPE)
endfunction()

# Splits a rule into comparisons; returns the list of 'KEY;OP;NUMBER;JOIN'
# quadruples flattened (JOIN is and/or/end).
function(_ppiclf_parse_rule group rule out)
  string(REGEX REPLACE "[ \t]+" ";" tokens "${rule}")
  set(parsed "")
  list(LENGTH tokens n)
  set(i 0)
  while(i LESS n)
    math(EXPR j1 "${i} + 1")
    math(EXPR j2 "${i} + 2")
    math(EXPR j3 "${i} + 3")
    if(j2 GREATER_EQUAL n)
      message(FATAL_ERROR "ppiclf_slots.txt: rule for ${group} incomplete: ${rule}")
    endif()
    list(GET tokens ${i} key)
    list(GET tokens ${j1} op)
    list(GET tokens ${j2} number)
    if(NOT op MATCHES "^(>=|>|==|<=|<)$" OR NOT number MATCHES "^-?[0-9]+$")
      message(FATAL_ERROR "ppiclf_slots.txt: rule for ${group}: cannot read "
                          "'${key} ${op} ${number}' (KEY op integer)")
    endif()
    list(FIND PPICLF_RULE_KEYS "${key}" at)
    if(at EQUAL -1)
      message(FATAL_ERROR "ppiclf_slots.txt: rule for ${group} uses key ${key}, which "
                          "is not in PPICLF_RULE_KEYS (cmake/PpiclfLayout.cmake)")
    endif()
    set(join end)
    if(j3 LESS n)
      list(GET tokens ${j3} join)
      if(NOT join MATCHES "^(and|or)$")
        message(FATAL_ERROR "ppiclf_slots.txt: rule for ${group}: expected 'and' or 'or', got '${join}'")
      endif()
    endif()
    list(APPEND parsed "${key}" "${op}" "${number}" "${join}")
    math(EXPR i "${i} + 4")
  endwhile()
  set(${out} "${parsed}" PARENT_SCOPE)
endfunction()

function(_ppiclf_compare value op number out)
  set(result FALSE)
  if(op STREQUAL ">=" AND value GREATER_EQUAL number)
    set(result TRUE)
  elseif(op STREQUAL ">" AND value GREATER number)
    set(result TRUE)
  elseif(op STREQUAL "==" AND value EQUAL number)
    set(result TRUE)
  elseif(op STREQUAL "<=" AND value LESS_EQUAL number)
    set(result TRUE)
  elseif(op STREQUAL "<" AND value LESS number)
    set(result TRUE)
  endif()
  set(${out} ${result} PARENT_SCOPE)
endfunction()

# Evaluates a parsed rule for a case ('and' binds before 'or').
function(_ppiclf_eval_rule case parsed out)
  set(any FALSE)
  set(term TRUE)
  while(parsed)
    list(POP_FRONT parsed key op number join)
    _ppiclf_split_key("${key}" section name)
    _ppiclf_input_value("${case}" "${section}" "${name}" value)
    _ppiclf_compare("${value}" "${op}" "${number}" holds)
    if(NOT holds)
      set(term FALSE)
    endif()
    if(NOT join STREQUAL "and")
      if(term)
        set(any TRUE)
      endif()
      set(term TRUE)
    endif()
  endwhile()
  set(${out} ${any} PARENT_SCOPE)
endfunction()

# The rule as a Fortran logical expression.
function(_ppiclf_fortran_rule parsed out)
  set(text "")
  while(parsed)
    list(POP_FRONT parsed key op number join)
    list(FIND PPICLF_RULE_KEYS "${key}" at)
    math(EXPR at "${at} + 1")
    list(GET PPICLF_RULE_KEYS ${at} variable)
    string(APPEND text "${variable} ${op} ${number}")
    if(join STREQUAL "and")
      string(APPEND text " .AND. ")
    elseif(join STREQUAL "or")
      string(APPEND text " .OR. ")
    endif()
  endwhile()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(_ppiclf_write_if_different file text)
  file(WRITE "${file}.tmp" "${text}")
  file(COPY_FILE "${file}.tmp" "${file}" ONLY_IF_DIFFERENT)
  file(REMOVE "${file}.tmp")
endfunction()

function(ppiclf_layout table case layout_header check_include out_groups)
  file(STRINGS "${table}" lines)
  set_property(DIRECTORY ${PROJECT_SOURCE_DIR} APPEND PROPERTY
               CMAKE_CONFIGURE_DEPENDS "${table}")
  if(case)
    set_property(DIRECTORY ${PROJECT_SOURCE_DIR} APPEND PROPERTY
                 CMAKE_CONFIGURE_DEPENDS "${case}")
  endif()

  # Pass 1: groups (in order of first slot line) and rules
  set(groups "")
  set(rule_groups "")
  foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(REGEX REPLACE "[ \t]+" ";" fields "${line}")
    list(POP_FRONT fields kind group)
    if(kind STREQUAL "rule")
      if(group IN_LIST rule_groups)
        message(FATAL_ERROR "${table}: two rules for group ${group}")
      endif()
      list(JOIN fields " " rule_${group})
      list(APPEND rule_groups "${group}")
    elseif(kind MATCHES "^(y|rprop|pro)$")
      if(NOT fields)
        message(FATAL_ERROR "${table}: no slot names in: ${line}")
      endif()
      if(NOT group IN_LIST groups)
        list(APPEND groups "${group}")
      endif()
    else()
      message(FATAL_ERROR "${table}: line must start with rule, y, rprop or pro: ${line}")
    endif()
  endforeach()
  foreach(group IN LISTS rule_groups)
    if(NOT group IN_LIST groups)
      message(FATAL_ERROR "${table}: rule for group ${group}, which has no slots")
    endif()
    _ppiclf_parse_rule("${group}" "${rule_${group}}" parsed_${group})
  endforeach()

  # Groups of this build
  set(built "")
  foreach(group IN LISTS groups)
    set(take TRUE)
    if(case AND group IN_LIST rule_groups)
      _ppiclf_eval_rule("${case}" "${parsed_${group}}" take)
    endif()
    if(take)
      list(APPEND built "${group}")
    endif()
  endforeach()

  # PPICLF_LAYOUT.h
  set(text "! PPICLF_LAYOUT.h: generated by CMake from\n")
  string(APPEND text "! libpicl/user_files/ppiclf_slots.txt. Do not edit.\n")
  # Only the groups, not the case's path: cases with the same physics share
  # a build without recompiling
  if(case)
    string(APPEND text "! Built for a case: only the groups its input needs\n")
  else()
    string(APPEND text "! Built for any case (every group)\n")
  endif()
  string(APPEND text "! Groups in this build: ${built}\n")
  set(comments "")
  foreach(array y rprop pro)
    set(count_${array} 0)
  endforeach()
  foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "")
      set(comments "")
    elseif(line MATCHES "^#(.*)$")
      string(APPEND comments "!${CMAKE_MATCH_1}\n")
    else()
      string(REGEX REPLACE "[ \t]+" ";" fields "${line}")
      list(POP_FRONT fields kind group)
      if(kind STREQUAL "rule")
        set(comments "")
        continue()
      endif()
      string(APPEND text "${comments}")
      set(comments "")
      foreach(name IN LISTS fields)
        if(DEFINED slot_${name})
          message(FATAL_ERROR "${table}: slot ${name} listed twice")
        endif()
        set(slot_${name} 1)
        if(group IN_LIST built)
          math(EXPR count_${kind} "${count_${kind}} + 1")
          string(APPEND text "#define PPICLF_${name} ${count_${kind}}\n")
        else()
          string(APPEND text "#define PPICLF_${name} 0\n")
        endif()
      endforeach()
    endif()
  endforeach()
  string(APPEND text "! Number of slots of each array in this build\n")
  string(APPEND text "#define PPICLF_NSLOTS_Y ${count_y}\n")
  string(APPEND text "#define PPICLF_NSLOTS_RPROP ${count_rprop}\n")
  string(APPEND text "#define PPICLF_NSLOTS_PRO ${count_pro}\n")
  _ppiclf_write_if_different("${layout_header}" "${text}")

  # Fortran check: the groups left out must not be needed by the input
  set(check "! PPICLF_LAYOUT_CHECK.inc: generated by CMake from\n")
  string(APPEND check "! libpicl/user_files/ppiclf_slots.txt. Do not edit.\n")
  string(APPEND check "! Stops if the input needs a slot group this build does not have.\n")
  foreach(group IN LISTS rule_groups)
    if(NOT group IN_LIST built)
      _ppiclf_fortran_rule("${parsed_${group}}" condition)
      # ErrorStop keeps 160 characters, 27 of them its own text
      set(message "Input needs ppiclF slots '${group}' (${rule_${group}}), not in this build: use ./rocflu.sh run")
      string(LENGTH "${message}" length)
      if(length GREATER 130)
        message(FATAL_ERROR "${table}: rule for ${group} too long for the start-up message")
      endif()
      string(APPEND check "  IF ( ${condition} ) THEN\n")
      string(APPEND check "    CALL ErrorStop(global,ERR_INVALID_VALUE,__LINE__, &\n")
      string(APPEND check "      \"${message}\")\n")
      string(APPEND check "  END IF\n")
    endif()
  endforeach()
  _ppiclf_write_if_different("${check_include}" "${check}")

  set(${out_groups} "${built}" PARENT_SCOPE)
endfunction()
