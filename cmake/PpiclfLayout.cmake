# Writes PPICLF_LAYOUT.h, the slot numbers of ppiclF's field arrays, from
# the table libpicl/user_files/ppiclf_slots.txt (see its header).
#
#   ppiclf_write_layout(<table> <output> <groups>)
#
# <groups> lists the groups to include; slots of the other groups are
# defined as 0. Within each array the included slots are numbered 1, 2, ...
# in the order of the table.

function(ppiclf_write_layout table output groups)
  file(STRINGS "${table}" lines)
  set_property(DIRECTORY ${PROJECT_SOURCE_DIR} APPEND PROPERTY
               CMAKE_CONFIGURE_DEPENDS "${table}")

  set(text "! PPICLF_LAYOUT.h: generated by CMake from\n")
  string(APPEND text "! libpicl/user_files/ppiclf_slots.txt. Do not edit.\n")
  string(APPEND text "! Groups in this build: ${groups}\n")
  set(comments "")
  foreach(array y rprop pro)
    set(count_${array} 0)
  endforeach()

  foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "")
      set(comments "")
    elseif(line MATCHES "^#(.*)$")
      string(APPEND comments "!${CMAKE_MATCH_1}\n")
    else()
      string(REGEX REPLACE "[ \t]+" ";" fields "${line}")
      list(POP_FRONT fields array group)
      if(NOT array MATCHES "^(y|rprop|pro)$")
        message(FATAL_ERROR "${table}: unknown array '${array}' in: ${line}")
      endif()
      if(NOT fields)
        message(FATAL_ERROR "${table}: no slot names in: ${line}")
      endif()
      string(APPEND text "${comments}")
      set(comments "")
      list(FIND groups "${group}" included)
      foreach(name IN LISTS fields)
        if(DEFINED slot_${name})
          message(FATAL_ERROR "${table}: slot ${name} listed twice")
        endif()
        set(slot_${name} 1)
        if(included EQUAL -1)
          string(APPEND text "#define PPICLF_${name} 0\n")
        else()
          math(EXPR count_${array} "${count_${array}} + 1")
          string(APPEND text "#define PPICLF_${name} ${count_${array}}\n")
        endif()
      endforeach()
    endif()
  endforeach()

  file(WRITE "${output}.tmp" "${text}")
  file(COPY_FILE "${output}.tmp" "${output}" ONLY_IF_DIFFERENT)
  file(REMOVE "${output}.tmp")
endfunction()
